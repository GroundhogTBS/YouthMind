{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "incremental": false,
    "noEmit": true
  },
  "include": [],
  "exclude": [
    "node_modules",
    "dist",
    "**/node_modules/**",
    "**/dist/**"
  ]
}
