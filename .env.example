# ===========================================
# YouthMind 环境变量配置
# ===========================================
# 请复制此文件为 .env 并填写实际值

# -------------------------------------------
# 数据库配置（SQLite - 无需配置）
# -------------------------------------------
DATABASE_URL=file:./data/youthmind.db

# -------------------------------------------
# JWT配置
# -------------------------------------------
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRES_IN=7d

# -------------------------------------------
# AI服务配置（文心一言）
# -------------------------------------------
# 访问 https://console.bce.baidu.com/ 申请
ERNIE_API_KEY=your_api_key
ERNIE_SECRET_KEY=your_secret_key

# -------------------------------------------
# 服务端口
# -------------------------------------------
CORE_SERVICE_PORT=8001
CHAT_SERVICE_PORT=8002
ALERT_SERVICE_PORT=8003
AI_SERVICE_PORT=9001

# -------------------------------------------
# 服务间通信
# -------------------------------------------
AI_SERVICE_URL=http://localhost:9001
CORE_SERVICE_URL=http://localhost:8001
CHAT_SERVICE_URL=http://localhost:8002
ALERT_SERVICE_URL=http://localhost:8003

# -------------------------------------------
# 文件存储配置
# -------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# -------------------------------------------
# 预警配置
# -------------------------------------------
# 红色预警通知管理员
ALERT_RED_NOTIFY_ADMIN=true
# 橙色预警通知管理员
ALERT_ORANGE_NOTIFY_ADMIN=true
# 黄色预警通知管理员
ALERT_YELLOW_NOTIFY_ADMIN=false

# -------------------------------------------
# 对话配置
# -------------------------------------------
# 会话最大时长(秒)
CHAT_MAX_SESSION_DURATION=3600
# 消息最大长度
CHAT_MAX_MESSAGE_LENGTH=2000
# 上下文消息数量
CHAT_CONTEXT_MESSAGES=10

# -------------------------------------------
# 日志配置
# -------------------------------------------
LOG_LEVEL=info
LOG_DIR=./logs

# -------------------------------------------
# 安全配置
# -------------------------------------------
# 密码加密盐轮次
BCRYPT_SALT_ROUNDS=10
# API限流(每分钟请求数)
RATE_LIMIT_PER_MINUTE=100
