{
  "name": "youthmind",
  "version": "1.0.0",
  "description": "YouthMind - 青少年心理AI辅导平台",
  "private": true,
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "cd backend/api && npm run start:dev",
    "dev:ai": "cd ai-service/unified-ai-service && venv/Scripts/python.exe -m uvicorn main:app --host 0.0.0.0 --port 9001 --reload",
    "dev:front": "cd frontend/teen-app && npm run dev:h5",
    "dev:admin": "cd frontend/admin-web && npm run dev",
    "build": "npm run build:api",
    "build:api": "cd backend/api && npm run build",
    "install:all": "npm install && cd backend/api && npm install",
    "db:init": "node scripts/init-db.js"
  },
  "devDependencies": {
    "better-sqlite3": "^9.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
